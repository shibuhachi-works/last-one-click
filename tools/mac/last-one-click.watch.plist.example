<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  見張り役を 5 分おきに動かす launchd の設定(手順は docs/auto-draft-mac.md の 4.)。
  /Users/YOU/last-one-click の 3 か所を、リポジトリを置いた場所に書き換えてから
  ~/Library/LaunchAgents/local.last-one-click.watch.plist として保存する。
  LaunchAgents(ログイン中のユーザーの画面側)で動くので、下書きを作るブラウザの窓が画面に出る。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.last-one-click.watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/YOU/last-one-click/tools/mac/watch.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/YOU/last-one-click/.watch.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/last-one-click/.watch.log</string>
</dict>
</plist>
