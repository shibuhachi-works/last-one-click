# 見張り役を 1 回動かす(timer から呼ばれる)。手順は docs/auto-draft-linux.md の 4.
# ~/.config/systemd/user/ に置く。%h はホームディレクトリ。リポジトリを ~/last-one-click 以外に置いたときは書き換える
[Unit]
Description=Last One Click: マージした記事を note の下書きにする見張り役
# デスクトップにログインしてから動かす(ブラウザの窓を画面に出すため)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=%h/last-one-click/tools/linux/watch.sh
# 時間の上限は付けない(待つモード LOC_WATCH_MODE=hold では、人が窓を閉じるまで終わらないため)。
# 終わるまでは timer が次を始めないので、二重には動かない
TimeoutStartSec=infinity
